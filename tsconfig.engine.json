{
  // Emits the SQL engine (src/sql) as plain ES modules into public/engine for the browser's live preview.
  // Same source as the server uses; `.ts` import specifiers are rewritten to `.js`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src/sql",
    "outDir": "public/engine",
    "removeComments": true
  },
  "include": ["src/sql/**/*.ts"]
}
